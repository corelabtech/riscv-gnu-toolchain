[submodule "binutils"]
	path = binutils
	url = ../binutils-gdb.git
	branch = corelab/binutils-2_44-branch
[submodule "gcc"]
	path = gcc
	url = ../gcc.git
	branch = corelab/gcc-14
[submodule "glibc"]
	path = glibc
	url = https://sourceware.org/git/glibc.git
[submodule "dejagnu"]
	path = dejagnu
	url = https://git.savannah.gnu.org/git/dejagnu.git
	branch = master
[submodule "newlib"]
	path = newlib
	url = ../newlib-cygwin.git
	branch = corelab/main
[submodule "gdb"]
	path = gdb
	url = ../binutils-gdb.git
	branch = corelab/gdb-16-branch
[submodule "qemu"]
	path = qemu
    url = ../qemu.git
    branch = at-v1.0
[submodule "musl"]
	path = musl
	url = https://git.musl-libc.org/git/musl
	branch = master
[submodule "spike"]
	path = spike
	url = https://github.com/riscv-software-src/riscv-isa-sim.git
	branch = master
[submodule "pk"]
	path = pk
	url = https://github.com/riscv-software-src/riscv-pk.git
	branch = master
[submodule "llvm"]
	path = llvm
	url = ../llvm-project.git
    branch = corelab/20.x
[submodule "riscv-openocd"]
	path = riscv-openocd
	url = ../riscv-openocd.git
